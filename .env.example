# ============================================================
# Aiselling — environment variables
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# ============================================================

# ---- Supabase ----------------------------------------------
# Project Settings → Data API / API Keys in the Supabase dashboard.

# Public — safe to expose to the browser (RLS protects your data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Site --------------------------------------------------
# Public base URL, used for auth redirect callbacks (magic link + OAuth).
# Local dev: http://localhost:3000 — Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Lemon Squeezy (Merchant of Record) --------------------
# Settings → API in Lemon Squeezy. Use a TEST-mode store + key while testing.
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
# Store ID (the number, e.g. 12345) — Settings → Stores.
LEMONSQUEEZY_STORE_ID=your-store-id
# Webhook signing secret you set when creating the webhook (Settings → Webhooks).
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
# Set to "true" to create checkouts in test mode (test-store/test card flow).
LEMONSQUEEZY_TEST_MODE=true
